<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SpaRoot>../../web/infragraph-admin/</SpaRoot>
    <SpaProxyServerUrl>http://localhost:5173</SpaProxyServerUrl>
    <SpaProxyLaunchCommand>npm run dev -- --host 127.0.0.1</SpaProxyLaunchCommand>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../InfraGraph.Modules/InfraGraph.Modules.csproj" />
    <ProjectReference Include="../InfraGraph.Infrastructure/InfraGraph.Infrastructure.csproj" />
    <ProjectReference Include="../InfraGraph.Contracts/InfraGraph.Contracts.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" />
  </ItemGroup>
  <Target Name="PublishReact" AfterTargets="ComputeFilesToPublish" Condition="'$(Configuration)' == 'Release' and '$(SkipSpaBuild)' != 'true'">
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm ci --no-audit --no-fund" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" />
    <ItemGroup>
      <DistFiles Include="$(SpaRoot)dist/**" />
      <ResolvedFileToPublish Include="@(DistFiles->'%(FullPath)')">
        <RelativePath>wwwroot/%(RecursiveDir)%(FileName)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
