{
  "name": "infragraph-admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run tokens:build && vite",
    "build": "npm run tokens:build && tsc -b && vite build && npm run production:check",
    "lint": "oxlint",
    "preview": "vite preview",
    "tokens:build": "node scripts/generate-tokens.mjs",
    "tokens:check": "node scripts/generate-tokens.mjs --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "architecture:check": "node scripts/check-boundaries.mjs",
    "production:check": "node scripts/check-production-bundle.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@microsoft/signalr": "^10.0.0",
    "@tanstack/react-query": "^5.108.1",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.26",
    "@xyflow/react": "^13.0.2",
    "dompurify": "^3.4.18",
    "lucide-react": "^1.76.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-resizable-panels": "^4.24.1",
    "react-router": "^8.5.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^31.0.1",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
}
